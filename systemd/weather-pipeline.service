[Unit]
Description=Weather Model Pipeline (unified: HRRR + NAM3km + IFS)
After=network-online.target
Wants=network-online.target

[Service]
User=wx
Group=wx
WorkingDirectory=/home/main/weather-viewer
Environment="PYTHONPATH=/home/main/weather-viewer"
Environment="MPLBACKEND=Agg"
Environment="MALLOC_MMAP_THRESHOLD_=131072"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
Environment="MODEL_WORKER_MAX_TASKS=16"
Environment="SHARED_RENDER_WORKERS=6"
Environment="MODEL_TASK_METRICS=1"
Environment="BALANCED_POOL_MODE=1"
Environment="OPENBLAS_NUM_THREADS=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
Environment="NUMEXPR_NUM_THREADS=1"
Environment="LOWPRI_WORKERS=0"
Environment="BURST_RENDER_ENABLED=false"
Environment="BURST_RENDER_MAX_SUBWORKERS=1"
Environment="AFFINITY_POOL_MODE=true"
Environment="AFFINITY_POOL_A_WORKERS=2"
Environment="AFFINITY_POOL_B_WORKERS=2"
Environment="AFFINITY_POOL_C_WORKERS=2"
Environment="AFFINITY_CATCHALL_WORKERS=0"
Environment="AFFINITY_POOL_LEASE_FXX=2"
Environment="AFFINITY_POOL_IDLE_RELEASE_SECONDS=180"
Environment="AFFINITY_POOL_BURST_SUBWORKERS=1"
ExecStart=/home/main/weather-viewer/.venv/bin/python -m pipeline.unified_scheduler
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
# Ensure all child processes (render workers) are killed on stop/restart
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
