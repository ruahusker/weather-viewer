[Unit]
Description=GOES Satellite Pipeline
After=network-online.target
Wants=network-online.target

[Service]
User=wx
Group=wx
WorkingDirectory=/home/main/weather-viewer
Environment="PYTHONPATH=/home/main/weather-viewer"
Environment="OPENBLAS_NUM_THREADS=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
Environment="NUMEXPR_NUM_THREADS=1"
Environment="MPLBACKEND=Agg"
Environment="MALLOC_MMAP_THRESHOLD_=131072"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
ExecStart=/home/main/weather-viewer/.venv/bin/python -m pipeline.satellite.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
# OS-level CPU cap: 100% of one core for the entire satellite process
# (all threads share this quota — enforced by systemd via cgroups v2)
CPUQuota=100%

[Install]
WantedBy=multi-user.target
