[Unit]
Description=Weather Model Pipeline (ECMWF IFS downloader + renderer)
After=network-online.target
Wants=network-online.target

[Service]
User=wx
Group=wx
WorkingDirectory=/home/main/weather-viewer
Environment="PYTHONPATH=/home/main/weather-viewer"
Environment="MPLBACKEND=Agg"
ExecStart=/home/main/weather-viewer/.venv/bin/python -m pipeline.scheduler_ifs
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
